/* Network-omniscience operator surface over the banked census + topology
 * stores (node_census, census_observations under <datadir>/peers_projection.db;
 * topology_edges, topology_sweeps under <datadir>/topology.db). Read-only;
 * degrade gracefully when the indexer lane has not populated a table yet. See
 * tools/command/native_net_census.c. */
ZCL_COMMAND_READY_READ(
    "core.network.census", "core.network", "",
    "Paginated list of every node the crawler has seen",
    "Nodes from the banked network census (node_census) read from "
    "<datadir>/peers_projection.db at call time, newest-last_seen first, "
    "bounded to a hard page cap; filters --ua-contains/--min-height/"
    "--seen-within and --page/--limit. SQL fallback: SELECT hex(ip),port,"
    "user_agent,protocol_version,last_reported_height,last_seen FROM "
    "node_census ORDER BY last_seen DESC. Says 'census empty: indexer not "
    "yet populated' when the store is absent.", ZCL_COMMAND_LIST_BUDGET,
    "network,census,nodes,useragent,version,peers,population,omniscience",
    "zcl.network_census.input.v1", "zcl.network_census.v1",
    "ua-contains,min-height,seen-within,page,limit", "",
    "zclassic23 core network census --ua-contains=MagicBean --limit=25",
