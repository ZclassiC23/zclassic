    "zcl.mining_status.v1", "", "", "zclassic23 core mining status",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)
ZCL_COMMAND_READY_READ(
    "core.mining.benchmark", "core.mining", "", "Run an Equihash solver benchmark",
    "A freshly measured Equihash solver benchmark (solutions/sec) run "
    "live on this call on the node's hardware, not a cached or "
    "historical figure.", 0,
    "mining,benchmark,equihash,solver", "zcl.command.empty_input.v1",
    "zcl.mining_benchmark.v1", "", "", "zclassic23 core mining benchmark",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)

/* core.node — local node lifecycle. Pre-RPC boot observability: unlike every
 * other core leaf these do NOT contact a running node. They read
 * <datadir>/boot_status.json straight off disk (tools/command/native_command.c),
 * so they answer "what boot stage / is it serving?" during the window before
 * RPC binds — the typed replacement for ss/ps/tail node.log boot watching.
 * Core owns boot + process ownership (NATIVE_COMMAND_INTERFACE §2). */
ZCL_COMMAND_BRANCH("core.node", "core", "Local node lifecycle",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.node.bootstatus", "core.node", "", "Pre-RPC boot status",
    "Boot stage, progress, and serving state read directly from "
    "<datadir>/boot_status.json on disk at call time, not via RPC; "
    "valid even before the node's RPC port binds.", 0,
    "boot,bootstatus,startup,progress,phase,stage,serving",
    "zcl.core_bootstatus.input.v1", "zcl.core_bootstatus.v1", "datadir", "",
    "zclassic23 core node bootstatus -datadir=/home/you/.zclassic-c23",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_node_bootstatus)
ZCL_COMMAND_READY_READ(
    "core.node.bootwait", "core.node", "", "Wait for boot to serve",
    "Polls <datadir>/boot_status.json on disk at the given heartbeat "
    "interval and reports once the node starts serving or the timeout "
    "elapses; valid even before RPC binds.", 0,
    "boot,bootwait,wait,startup,serving,ready",
    "zcl.core_bootwait.input.v1", "zcl.core_bootstatus.v1",
    "datadir,timeout_ms,heartbeat_ms", "",
    "zclassic23 core node bootwait -datadir=/home/you/.zclassic-c23 --timeout_ms=120000",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_node_bootwait)

/* ── identity (sovereign master keys) ──────────────────────────────
 * The chain-rooted answer to "whose key is this, and is it still live?".
 * Reads resolve the zid_identities projection (app/models/src/
 * zid_identity.c), fed from confirmed chain data by both identity feeds
 * (app/models/src/explorer_index_zid.c): the dedicated ZID\0 OP_RETURN
 * overlay and the ZNAM "zid" text-record convention. Writes build that
 * same overlay: with a live node they dispatch the wallet compose +
 * broadcast through the identity_* RPCs; with no live node (or no wallet)
 * they return op_return_hex for the operator to include. Never on a
 * timer — anchoring spends a fee and stays an operator decision. */
ZCL_COMMAND_BRANCH("core.identity", "core",
                   "Sovereign identities: resolve and anchor master keys",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_READ(
    "core.identity.resolve", "core.identity", "",
    "Resolve one master key by pubkey or ZNAM name",
    "The identity row the chain says exists for a 32-byte ed25519 master "
    "key, read from the datadir's node.db at call time (works on a "
    "stopped or copied datadir): pubkey, name, anchor_txid, "
    "anchor_height, updated_height, status (active/rotated/revoked), "
    "successor (set exactly when rotated), owner_address, and source "
    "(zid_overlay or znam_text). Select with --pubkey=<64hex> or "
    "--name=<znam name>, never both. A key with no anchor row is a hard "
    "KEY_NOT_ANCHORED and an unknown name a hard NAME_NOT_FOUND — an "
    "unanchored key is a real answer, not an empty one.", 0,
    "identity,zid,resolve,pubkey,anchor,master,key,name",
    "zcl.core_identity_resolve.input.v1", "zcl.core_identity_resolve.v1",
    "pubkey,name,datadir", "pubkey",
    "zclassic23 core identity resolve --pubkey=<64hex>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_OFFLINE_COPY,
    ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_identity_resolve)
ZCL_COMMAND_READY_COMMAND(
    "core.identity.anchor", "core.identity", "",
    "Anchor a master key on-chain (spends a fee)",
    "Builds the ZID\\0 ANCHOR OP_RETURN binding --pubkey=<64hex> to the "
    "chain. With a live node: dispatches the wallet compose+broadcast "
    "through the identity_anchor RPC and returns the txid (the node "
    "itself returns op_return_hex when no wallet is loaded). With no "
    "live node: returns op_return_hex plus the exact next step. Refuses "
    "an all-zero key and a key already anchored to another owner. Never "
    "runs on a timer — every anchor is an explicit operator decision.", 0,
    "identity,zid,anchor,publish,master,key,broadcast,fee",
    "zcl.core_identity_anchor.input.v1", "zcl.core_identity_anchor.v1",
    "pubkey,datadir", "pubkey",
    "zclassic23 core identity anchor --pubkey=<64hex>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_core_identity_anchor)
ZCL_COMMAND_READY_COMMAND(
    "core.identity.rotate", "core.identity", "",
    "Rotate an anchored master key to a successor (spends a fee)",
    "Builds the ZID\\0 ROTATE OP_RETURN superseding --pubkey=<64hex> with "
    "--new_pubkey=<64hex>. Pre-flight against the projection names the "
    "refusal before any fee is spent: KEY_NOT_ANCHORED when the old key "
    "has no row, ALREADY_REVOKED when its row is dead, SELF_ROTATE when "
    "old and new are the same key. The chain-side ownership proof is the "
    "tx's sole input — the live path composes it through "
    "zslp_command_build_owner_base_tx so the signer is provably the "
    "recorded owner, and a non-owner is refused NOT_OWNER.", 0,
    "identity,zid,rotate,successor,master,key,broadcast,fee",
    "zcl.core_identity_rotate.input.v1", "zcl.core_identity_anchor.v1",
    "pubkey,new_pubkey,datadir", "",
    "zclassic23 core identity rotate --input='{\"pubkey\":\"<64hex>\",\"new_pubkey\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_core_identity_rotate)
ZCL_COMMAND_READY_COMMAND(
    "core.identity.revoke", "core.identity", "",
    "Retire an anchored master key with no successor (spends a fee)",
    "Builds the ZID\\0 REVOKE OP_RETURN retiring --pubkey=<64hex>. A "
    "revoked key is dead, not superseded: nothing it ever signed verifies "
    "as current afterwards and no later ANCHOR resurrects it, so this is "
    "the one-way door. Pre-flight names KEY_NOT_ANCHORED (no row) and "
    "ALREADY_REVOKED (idempotent no-op) before any fee is spent; the "
    "live path proves ownership through the tx's sole input exactly like "
    "rotate.", 0,
    "identity,zid,revoke,retire,master,key,broadcast,fee",
    "zcl.core_identity_revoke.input.v1", "zcl.core_identity_anchor.v1",
    "pubkey,datadir", "pubkey",
    "zclassic23 core identity revoke --pubkey=<64hex>",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_core_identity_revoke)
ZCL_COMMAND_READY_READ(
    "core.identity.list", "core.identity", "",
    "Page the anchored identities, newest anchor first",
    "One page of the zid_identities projection read from the datadir's "
    "node.db, newest anchor height first: --limit (default 25, capped at "
    "100) and --offset walk it. Each row carries the same fields as "
    "resolve. The page header reports the total row count and the "
    "active/rotated/revoked split, so a caller can see the whole "
    "population without walking every page.", ZCL_COMMAND_LIST_BUDGET,
    "identity,zid,list,index,page,anchors",
    "zcl.core_identity_list.input.v1", "zcl.core_identity_index.v1",
    "limit,offset,datadir", "",
    "zclassic23 core identity list --limit=25",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_SCOPE_OFFLINE_COPY,
    ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_CHAIN_READ, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_core_identity_list)

/* ── core.zdir.* — the on-chain node directory, WRITE side ──────────
 * A ZDIR record says one thing: "this v3 onion hostname is a node, and
 * this t-address paid for saying so." Every node folds confirmed records
 * out of block history into its onion_directory projection and may dial
 * them, so this is how a node stops being invisible to strangers without
 * asking any seed operator for permission. A row is a HINT ABOUT WHERE TO
 * LOOK, never proof of who is there: the directory only ever ADDS dial
 * candidates alongside DNS seeds, fixed seeds and addrman, and has no path
 * to exclude a peer. With a live node these dispatch the wallet
 * compose+broadcast through the zdir_* RPCs; with no live node (or no
 * wallet) they return op_return_hex for the operator to include. There is
 * no transfer leaf on purpose — ZDIR command byte 3 is reserved and
 * zdir_parse rejects it, so handing a hostname to another operator is
 * deregister by the current owner then register by the new one. Never on a
 * timer — publishing spends a fee and stays an operator decision. */
ZCL_COMMAND_BRANCH("core.zdir", "core",
                   "On-chain node directory: announce and retire onion hostnames",
                   ZCL_COMMAND_LAYER_CORE)
ZCL_COMMAND_READY_COMMAND(
    "core.zdir.register", "core.zdir", "",
    "Announce a v3 onion hostname on-chain as a node (spends a fee)",
    "Builds the ZDIR REGISTER OP_RETURN publishing --hostname=<56 base32 "
    "chars>.onion as a node, optionally binding it to a ZID master key "
    "with --pubkey=<64hex> (a binding is a claim, not a proof). With a "
    "live node: dispatches the wallet compose+broadcast through the "
    "zdir_register RPC and returns the txid (the node itself returns "
    "op_return_hex when no wallet is loaded). With no live node: returns "
    "op_return_hex plus the exact next step. The hostname is held to the "
    "one Tor v3 rule the node has, so a v2 onion or a bare hostname is a "
    "hard BAD_HOSTNAME. Re-registering your own hostname refreshes the "
    "record and its key binding but never resets its registration height "
    "— seniority is not free to fake. A row that records no owner is "
    "permanently immutable and refused NOT_OWNER before any fee is spent. "
    "Never runs on a timer — every registration is an explicit operator "
    "decision.", 0,
    "zdir,directory,onion,register,announce,publish,peer,discovery,broadcast,fee",
    "zcl.core_zdir_register.input.v1", "zcl.core_zdir_register.v1",
    "hostname,pubkey,datadir", "hostname",
    "zclassic23 core zdir register --hostname=<56 base32>.onion",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_core_zdir_register)
ZCL_COMMAND_READY_COMMAND(
    "core.zdir.deregister", "core.zdir", "",
    "Retire an onion hostname from the on-chain directory (spends a fee)",
    "Builds the ZDIR DEREGISTER OP_RETURN retiring --hostname=<56 base32 "
    "chars>.onion. The row stays on-chain — its registration height is "
    "its seniority and its history — it just stops being dialed. "
    "Pre-flight against the projection names the refusal before any fee "
    "is spent: NOT_REGISTERED when no row exists, ALREADY_RETIRED when it "
    "is already retired, NOT_OWNER when the row records no owner. The "
    "chain-side ownership proof is the tx's sole input — the live path "
    "composes it through zslp_command_build_owner_base_tx so the signer "
    "is provably the recorded owner. To hand a hostname to another "
    "operator, deregister it and let them register it; there is no "
    "transfer command and there is not going to be a silent stub of one. "
    "Never runs on a timer — every retirement is an explicit operator "
    "decision.", 0,
    "zdir,directory,onion,deregister,retire,withdraw,peer,discovery,broadcast,fee",
    "zcl.core_zdir_deregister.input.v1", "zcl.core_zdir_register.v1",
    "hostname,datadir", "hostname",
    "zclassic23 core zdir deregister --hostname=<56 base32>.onion",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_core_zdir_deregister)
