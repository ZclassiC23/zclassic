    "core.wallet.address.label", "core.wallet.address", "",
    "Set or clear the label on an address",
    "The address's label row as persisted after the upsert (address, "
    "label, updated_at); idempotent, so re-setting the same label "
    "returns that settled state. An empty label clears it. Carries no "
    "key or fund risk: it writes a plain annotation row, never the "
    "wallet keystore.", 0,
    "wallet,address,label,rename,contact",
    "zcl.wallet_label_input.v1", "zcl.wallet_label.v1", "address,label",
    "address",
    "zclassic23 core wallet address label --input='{\"address\":\"t1...\","
    "\"label\":\"friends\"}'",
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW, ZCL_COMMAND_CONFIRM_NONE,
