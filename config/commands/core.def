ZCL_COMMAND_READY_COMMAND(
    "core.wallet.address.export-key", "core.wallet.address", "",
    "Export the private key for an address",
    "Owner-gated plan/commit: without confirm, a non-revealing plan "
    "naming the address; with confirm:true, the raw private key from "
    "the node's dumpprivkey at call time (stage=committed).", 0,
    "wallet,export,privkey",
    "zcl.core_addr_ref.input.v1", "zcl.wallet_privkey.v1", "address,confirm",
    "address",
    "zclassic23 core wallet address export-key --address=<addr>",
    /* MUTATE/WALLET, not READ/READ. This leaf writes a raw spending key to
     * the caller's terminal: one call and every balance cap, confirm gate
     * and session bound below it is moot. It sat at the bottom rung —
     * literally the same tier as `core wallet balance` — so any consumer
     * keying on `risk` alone handed the key over; only a capability bit and
     * the confirm gate stood in the way.
     *
     * The registry couples the two axes (EFFECT_READ demands RISK_READ, see
     * zcl_command_registry_validate), so the risk cannot be raised without
     * the effect. Calling an irreversible disclosure an "effect" is the far
     * smaller inaccuracy of the two available ones. */
    ZCL_COMMAND_LAYER_CORE, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_WALLET,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_WALLET_REQUEST, ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_wallet_address_export_key)
