/* The six ZNAM writes use one durable identity-bound intent seam. Planning
 * signs the exact transaction, reserves its exact inputs plus maximum fee,
 * and returns only a sanitized plan receipt. Commit accepts only the explicit
 * wallet scope and durable plan ID, then publishes those same bytes once. */

ZCL_COMMAND_READY_COMMAND(
    "app.names.register", "app.names", "", "Register a ZCL Name on-chain",
    "Prepare an exact signed ZNAM registration and atomically reserve its "
    "inputs and maximum fee. Commit only the returned scope/plan_id; stale "
    "custody, changed tip/snapshot, duplicate input, or replay mismatch fails "
    "closed before publication.",
    0,
    "names,znam,register", "zcl.app_name_register.input.v1",
    "zcl.app_name_txresult.v1", "wallet_scope,name,type,value,idempotency_key,plan_id,confirm", "wallet_scope",
    "zclassic23 app names register --input='{\"wallet_scope\":\"dev\",\"name\":\"alice\",\"type\":\"zaddr\",\"value\":\"zs1..\",\"idempotency_key\":\"name-register-1\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_ZNAM,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_name_register)

