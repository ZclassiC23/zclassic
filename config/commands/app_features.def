/* ── Store (the /store storefront) ───────────────────────────────────
 *
 * NOT the ZCL Market above. app.market.* gossips file offers over P2P and is
 * PLANNED because nothing announces a locally created offer. app.store.* is
 * the shipped storefront served at /store — per-order Sapling payment
 * addresses, memo-bound reconciliation, token-gated download — and its
 * merchant side is executable here.
 *
 * These leaves address `<datadir>/node.db` directly (input.datadir, else the
 * process --datadir), exactly as the /store HTTP handler does on every
 * request. That is why a product listed here needs no restart to appear, and
 * why the command also works against a stopped node's datadir. */

ZCL_COMMAND_READY_COMMAND(
    "app.store.list-product", "app.store", "",
    "List a product for sale in the store",
    "The product row as the store will serve it, re-read from the products "
    "table after the write (not an echo of the request): its assigned id, "
    "normalized token_id, price in both units, and — when a file was "
    "attached — the SHA3-256 of the stored FILE BYTES. Refuses rather than "
    "half-lists: an unreadable/empty/over-cap content_path or a token_id an "
    "active product already holds writes nothing.", 0,
    "store,product,sell,merchant,listing",
    "zcl.app_store_list_product_input.v1", "zcl.app_store_product.v1",
    "datadir,name,description,price_zcl,price_zatoshi,token_id,"
    "tokens_per_purchase,content_path,content_type,content_filename", "",
    "zclassic23 app store list-product --input='{\"name\":\"Field guide\","
    "\"token_id\":\"GUIDE\",\"price_zcl\":0.25,"
    "\"content_path\":\"/srv/guide.pdf\"}'",
