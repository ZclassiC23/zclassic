    "wallet_scope,offer_id,source_address,chunk_start,chunks_paid,idempotency_key",
    "printf '%s' '{\"wallet_scope\":\"dev\",\"offer_id\":\"<64hex>\",\"source_address\":\"<owned-address>\",\"chunk_start\":0,\"chunks_paid\":1,\"idempotency_key\":\"lab-001\"}' | zclassic23 app market purchase plan --input=-",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
