/* ZCL built-in application features, mounted under the `app` root (the frozen
 * root set stays at seven: status/core/app/dev/ops/discover/code). These are the
 * native command surface for names (ZNAM), ZSLP tokens, messaging (ZMSG), the
 * file market, and cross-chain atomic swaps.
 *
 * Read leaves are READY and dispatch through zcl_native_bridge_command
 * (body functions in app/controllers/src/app_native_handlers.c, bound in
 * tools/command/native_command.c's g_bridge_tools[]/g_bridge_native_body[]).
 *
 * The WRITE leaves split on one question: does the backing RPC actually finish
 * the job its summary promises?
 *
 *   READY — the ZNAM writes, ZMSG send/read, and the two swap contract mints.
 *   Each backing handler builds, signs, admits and relays its own transaction
 *   (or writes to the peer socket / flips the read bit), so the native leaf is
 *   a typed front door onto finished work. Handlers live in
 *   app/controllers/src/app_write_native_handlers.c; every value-moving leaf
 *   honours its declared ZCL_COMMAND_CONFIRM_PLAN_COMMIT — a first call
 *   without confirm:true returns a non-mutating plan, only the confirmed call
 *   broadcasts — and a backing RPC that succeeds WITHOUT doing the job (a ZNAM
 *   write answering status="ready" because the node carries no wallet) is
 *   reported BLOCKED, never PASSED.
 *
 *   PLANNED — the three whose backing RPC stops short of its own summary. Each
 *   availability_reason below names the exact missing code path, not a generic
 *   "not implemented"; opening a native door onto them would mint a PASSED
 *   reply for work the node never performs.
 *
 * Consumer defines ZCL_COMMAND_*. */

/* Branch summaries are deliberately terse single words: they render inside the
 * parent `app` branch menu, which is bounded by ZCL_COMMAND_BRANCH_BUDGET and
 * already carries six longer-summary children (auth/account/list/inspect/
 * protocols/invoke). Keeping these short keeps the `app` menu well under
 * budget (verified in test_native_api_contract's per-branch menu sweep). */
ZCL_COMMAND_BRANCH("app.names", "app", "Names", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.tokens", "app", "Tokens", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.messaging", "app", "Messaging", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.market", "app", "Market", ZCL_COMMAND_LAYER_APP)
ZCL_COMMAND_BRANCH("app.swap", "app", "Swaps", ZCL_COMMAND_LAYER_APP)

/* ── Names (ZNAM) ──────────────────────────────────────────────────── */

ZCL_COMMAND_READY_READ(
    "app.names.resolve", "app.names", "", "Resolve a ZCL Name to its target",
    "One ZCL Name's resolved target (.onion, z-address, or t-address) looked up "
    "live on-chain at call time; absent/error if the name is not registered.", 0,
    "names,znam,resolve", "zcl.app_name_resolve.input.v1",
    "zcl.app_name_record.v1", "name", "name",
    "zclassic23 app names resolve alice",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_ZNAM,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)

ZCL_COMMAND_READY_READ(
    "app.names.list", "app.names", "", "List registered ZCL Names",
    "Every ZCL Name registered on the network, read live at call time; bounded "
    "to the list budget row cap, not full history.", ZCL_COMMAND_LIST_BUDGET,
    "names,znam,list", "zcl.command.empty_input.v1", "zcl.app_name_index.v1",
    "", "", "zclassic23 app names list",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_ZNAM,
    ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_bridge_command)

/* The six ZNAM writes below are READY. Each one's backing RPC
 * (app/controllers/src/name_controller.c) validates the name, builds the
 * OP_RETURN, coin-selects a funding input, signs every vin, and hands the tx
 * to zslp_command_commit_with_op_return -> wallet_commit_transaction, which
 * admits it to the mempool and relays it. Owner authorization is real and
 * doubly enforced: the controller refuses to build unless the wallet holds the
 * current owner's key AND funds a coin at that exact address
 * (zslp_command_build_owner_base_tx), and the ZNAM projection independently
 * re-derives the owner from the confirmed tx's vin[0]. RENEW is
 * permissionless by protocol design and funds from any wallet coin. */

ZCL_COMMAND_READY_COMMAND(
    "app.names.register", "app.names", "", "Register a ZCL Name on-chain",
    "Plan/commit ZNAM registration: without confirm, a non-mutating plan "
    "naming the registration and its commit_input; with confirm:true, the "
    "broadcast txid and fee paid from name_register at call time "
    "(stage=committed, status=broadcast). A node with no wallet context is "
    "reported BLOCKED (NAME_WRITE_NOT_BROADCAST), never as a silent success.",
    0,
    "names,znam,register", "zcl.app_name_register.input.v1",
    "zcl.app_name_txresult.v1", "name,type,value,confirm", "name",
    "zclassic23 app names register --input='{\"name\":\"alice\",\"type\":\"zaddr\",\"value\":\"zs1..\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_ZNAM,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_name_register)

ZCL_COMMAND_READY_COMMAND(
    "app.names.update", "app.names", "", "Replace a ZCL Name's primary target",
    "Plan/commit owner-only target replacement: without confirm, a "
    "non-mutating plan; with confirm:true, the broadcast txid and fee from "
    "name_update at call time (stage=committed, status=broadcast). Fails with "
    "the controller's own message when the wallet does not hold the current "
    "owner's key or has no funded coin at that address.", 0,
    "names,znam,update", "zcl.app_name_register.input.v1",
    "zcl.app_name_txresult.v1", "name,type,value,confirm", "name",
    "zclassic23 app names update --input='{\"name\":\"alice\",\"type\":\"zaddr\",\"value\":\"zs1..\",\"confirm\":true}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE, ZCL_COMMAND_RISK_APP_WRITE,
    ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OWNER, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_PLAN_COMMIT,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE, ZCL_COMMAND_CAP_ZNAM,
    ZCL_COMMAND_TRAIT_NONE,
    zcl_native_handle_name_update)

ZCL_COMMAND_READY_COMMAND(
    "app.names.transfer", "app.names", "", "Transfer ZCL Name ownership",
