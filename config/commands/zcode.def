/* ── slice 10: SIMULATED ZCODE Badges ──────────────────────────────────
 * Permanent achievement evidence, SIMULATED ZSLP-based assets in v1 (no
 * real ZSLP mint, no wallet call, no on-chain asset — the owner-reviewed
 * real issuance is slice 15). A badge commits to the badge type, the
 * recipient contributor key, the achievement period, the evidence root,
 * the issuing policy id, a unique per-issuer sequence, and the issuer
 * key under one signature (canonical binary encoding + domain-separated
 * SHA3 id — never signed JSON). A badge is PERMANENT: losing a
 * leaderboard position never revokes it. Dedup (never the same badge
 * twice for the same contributor + achievement period) is enforced at
 * plan (excluded with duplicate-badge) and re-checked at issue against
 * the current store. Eligibility derives from existing facts only
 * (slice-8 ledger, slice-9 rankings, slice-3 publish history);
 * popular-package and rare-package-seeder need P2P facts that arrive
 * with slices 11-12 and are named unavailable, never faked. The issuer
 * secret never enters lib/vcs — the issue handler signs through a
 * callback. */

ZCL_COMMAND_BRANCH("zcode.badge", "zcode",
                   "ZCODE Badges: permanent achievement evidence "
                   "(SIMULATED assets, plan/commit issuance)",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.badge.eligible", "zcode.badge", "",
