ZCL_COMMAND_READY_COMMAND(
    "zcode.package.dev.publish", "zcode.package.dev", "zcode.publish",
    "Publish accepted lane",
    "Publishes a new signed package release from an explicitly accepted lane "
    "(CANDIDATE or PROVEN) for an exact source root. Rebuilds the acceptance "
    "verification from the workspace CAS: the signed lane receipt, its "
    "task/candidate/policy binding, and the proof set must all reload, "
    "validate, and rederive their roots or the command refuses with "
    "LANE_NOT_ACCEPTED, LANE_ACCEPTANCE_INVALID, or PROOF_SET_INVALID. "
    "Package content is re-derived from CAS blobs with the exact lane "
    "receipt wire embedded as the canonical zcode-lane-receipt.v1 authority "
    "file, the task acceptance recipe becomes the build recipe, and the "
    "release commits through the existing zcode.package.publish commit "
    "lifecycle.",
    0, "zcode,publish,release,lane,accept,candidate,proven,sign",
    "zcl.zcode_publish.input.v1", "zcl.zcode_publish.v1",
    "workspace,datadir,source_root,publisher_secret,name,semver,license,reward_address,znam,task_root,lane_receipt_root,publisher_sequence,parent_release_root,day",
