ZCL_COMMAND_READY_READ(
    "zcode.package.peers", "zcode.package", "",
    "Live swarm peers advertising one package root",
    "The live swarm engine's per-peer view for one 64-hex package `root`: "
    "peer id, the LOCAL session pseudo-key (0x02 || SHA3-256(domain || "
    "host identity) — a transport-session scope for the service book, "
    "explicitly NOT a contributor identity), resolved tier, in-flight "
    "requests, verified bytes served/received both ways, the "
    "download-allowance-exhausted flag, and the book offence tally, plus "
    "the download status summary. Rows bounded at 32 (peers_truncated "
    "flags the rest). Peer facts are session-scoped and never persisted: "
    "without a live hosting engine the reply is live:false with an empty "
    "list — honestly, never replayed from disk.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,peers,swarm,advertisers,tier,session",
    "zcl.zcode_package_peers.input.v1", "zcl.zcode_package_peers.v1",
    "root,datadir", "root",
    "zclassic23 zcode package peers --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_peers)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.pin", "zcode.package", "",
    "Operator-pin a tracked package (PINS pool, never evicted)",
    "Pins one tracked 64-hex package `root` into the PINS pool: pinned "
    "packages are never evicted. This is the OPERATOR path — never "
    "tier-gated; the contributor-requested pin allowance "
    "(pin-allowance-exceeded, vcs_policy_check_pin — pins are earned) is "
    "a separate gate the swarm's serving side applies. Pinning fails "
    "with PINS_POOL_FULL when the package's bytes do not fit the pins "
    "budget (pins are never made room for by eviction) and "
    "UNKNOWN_PACKAGE names an untracked root.",
    0,
    "zcode,package,pin,operator,pins,quota",
    "zcl.zcode_package_pin.input.v1", "zcl.zcode_package_pin.v1",
    "root,datadir", "root",
    "zclassic23 zcode package pin --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_pin)

