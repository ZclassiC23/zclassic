ZCL_COMMAND_READY_COMMAND(
    "zcode.package.dev.evidence", "zcode.package.dev", "zcode.evidence",
    "Evaluate candidate evidence",
    "Re-verifies canonical work receipts from the existing workspace CAS, "
    "applies the task-bound proof_policy.v1, and reports whether the selected "
    "output has local reproduction or the user's approved distinct-signer "
    "quorum. Compile, test, fuzz, and approving review receipts are counted "
    "separately against their exact fixed action kinds; review.v1 must bind "
    "an existing trusted proof set. A release-byte-identity policy remains "
    "false until final release artifacts exist. Remote observations remain "
    "untrusted until reproduction or the applicable quorum passes. Emits "
    "and stores the canonical proof-set root used by review.v1.",
    0, "zcode,evidence,receipt,quorum,reproduce,proof",
