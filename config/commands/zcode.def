/* ZCODE — decentralized C23 source-package hosting (docs/work/ZCODE_PLAN.md).
 * This branch is the typed surface for the LOCAL publication half (slice 3):
 * plan/commit publication into the content-addressed store plus local
 * search/show over the rebuildable index projection. No P2P gossip, no
 * reward credit, no install/build/execution of published content — later
 * slices own those.
 *
 * THE INVARIANT OF THIS BRANCH: the CAS bytes under <datadir>/zcode are the
 * only package truth. Handlers call lib/vcs (package_publish / package_index
 * / package_store) directly; the index is rebuilt from the persisted wires
 * on every call and acceptance state is replayed from persisted releases, so
 * a one-shot CLI agrees with the node. Every rejection names the exact
 * failed rule.
 *
 * Consumer defines ZCL_COMMAND_*; see config/src/command_catalog.c. */

ZCL_COMMAND_BRANCH("zcode", "",
                   "ZCODE source-package hosting: publish, search, host",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.package", "zcode",
                   "Published packages: releases, manifests, chunks",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_BRANCH("zcode.package.publish", "zcode.package",
                   "Publish a signed release into the local store (plan, "
                   "then commit)",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.package.publish.plan", "zcode.package.publish", "",
    "Validate a candidate release without persisting anything",
    "A bounded validation report for the candidate named by release_hex "
    "(signed envelope wire) + manifest_hex (content.v2 wire), with chunks "
    "verified against the source `dir` when given: every failed rule is "
    "named in `failures[]` (envelope/signature, SPDX license allowlist and "
    "LICENSE file, package structure, 64 MiB cap, acceptance replay against "
    "persisted releases, chunk hashes), or `valid:true` with a plan_token "
    "(the release id — correlation only; commit re-validates). Nothing is "
    "persisted; `chunks_checked` says whether source bytes were read.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,publish,plan,validate,release,manifest,license",
    "zcl.zcode_publish_plan.input.v1", "zcl.zcode_publish_plan.v1",
    "release_hex,manifest_hex,dir,datadir", "",
    "zclassic23 zcode package publish plan --input='{\"release_hex\":\"..\",\"manifest_hex\":\"..\",\"dir\":\"/tmp/pkg\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_zcode_package_publish_plan)

ZCL_COMMAND_READY_COMMAND(
    "zcode.package.publish.commit", "zcode.package.publish", "",
    "Re-validate and persist a candidate release into the local store",
    "Runs the full publish-plan validation (naming the exact failed rule on "
    "rejection), then persists: the manifest and every chunk from `dir` "
    "into the content-addressed store (verify-before-store, dedup, atomic "
    "rename — a crash mid-commit leaves resumable staging, never partial "
    "visibility) and the release envelope into releases/. Idempotent: a "
    "redelivered release id reports result=duplicate. `chunks_stored` "
    "counts chunk admissions including dedup no-ops. Slice 11 policy "
    "checkpoint: a FRESH release is admitted only within the publisher "
    "key's per-ISO-week publish allowance for its tier (new user: 1/week "
    "— the free allowance; the tier resolves from earned score + the "
    "local verified-bytes ratio); a denial is PUBLISH_FREQUENCY_LIMIT "
    "naming the exact rule (publish-frequency-limit), and a successful "
    "fresh publish records the publication event in the local service "
    "book (the optional `day` input pins the window for deterministic "
    "testing; host clock when omitted). v1 operator boundary: "
    "do not run concurrently with a hosting node's own puts on the same "
    "datadir (the open-time recovery sweep is not cross-process "
    "coordinated).", 0,
    "zcode,package,publish,commit,persist,release,store",
    "zcl.zcode_publish_commit.input.v1", "zcl.zcode_publish_commit.v1",
    "release_hex,manifest_hex,dir,day,datadir", "",
    "zclassic23 zcode package publish commit --input='{\"release_hex\":\"..\",\"manifest_hex\":\"..\",\"dir\":\"/tmp/pkg\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_package_publish_commit)

ZCL_COMMAND_READY_READ(
    "zcode.package.search", "zcode.package", "",
    "Search locally published packages",
    "Bounded rows over the package index — a projection rebuilt from the "
    "persisted release/manifest wires at call time, never a second truth — "
    "filtered by `publisher` (pubkey hex prefix), `name_prefix` "
    "(publisher/package prefix), `license` (exact SPDX id), and/or "
    "`keyword` (name substring), all ANDed. Rows are sorted by (name, "
    "release id), capped at 16 (limit raises only within that cap), with "
    "`total_matches` and `items_truncated` stating completeness. An empty "
    "result means no persisted release matched, not that none were "
    "checked: `packages_scanned` names the corpus size.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,search,find,publisher,license,keyword",
    "zcl.zcode_package_search.input.v1", "zcl.zcode_package_search.v1",
    "publisher,name_prefix,license,keyword,limit,datadir", "",
    "zclassic23 zcode package search --input='{\"keyword\":\"ring\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_search)

ZCL_COMMAND_READY_READ(
    "zcode.package.show", "zcode.package", "",
    "Full release record and manifest summary for one package root",
    "The complete persisted release record (publisher, sequence, license, "
    "reward address, lineage, ZNAM pointer) plus the manifest summary "
    "(file/byte/chunk counts, LICENSE presence, executable count) for one "
    "64-hex package `root`, read from the rebuilt index projection at call "
    "time, plus a bounded first page of up to 32 manifest files "
    "(files_truncated flags the rest). UNKNOWN_PACKAGE names a root no "
    "persisted release claims.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,show,detail,manifest,release,root",
    "zcl.zcode_package_show.input.v1", "zcl.zcode_package_show.v1",
    "root,datadir", "root",
    "zclassic23 zcode package show --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_show)

/* ── slice 5: declarative C23 build recipe ─────────────────────────────
 * The recipe is declarative ONLY: the node never compiles or executes
 * downloaded code; compilation belongs to the external verifier
 * (zclassic23-package-verify, slice 6). */
ZCL_COMMAND_READY_READ(
    "zcode.package.recipe", "zcode.package", "",
    "Decoded declarative build recipe for one package root",
    "The declarative C23 build recipe (slice 5) committed by the release "
    "envelope's recipe_root for one 64-hex package `root`, decoded from "
    "the canonical recipe wire in the local store: public_headers, "
    "sources, test_sources, include_dirs, preprocessor_defines (each "
    "bounded at 32 entries with a per-list truncated flag), the v1 "
    "allowed_system_libraries (libc/libm/pthread only), and the expected "
    "test exit code / maximum test seconds / maximum memory bytes. JSON "
    "is display-only — the canonical wire and its root stay the truth. "
    "UNKNOWN_PACKAGE names a root no persisted release claims; "
    "RECIPE_NOT_HOSTED names a recipe root with no recipe wire stored.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,recipe,build,declarative,sources,root",
    "zcl.zcode_package_recipe.input.v1", "zcl.zcode_package_recipe.v1",
    "root,datadir", "root",
    "zclassic23 zcode package recipe --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_recipe)

/* ── slice 6: external verifier attestations ───────────────────────────
 * The node NEVER compiles or executes downloaded code: attestations are
 * signed by the SEPARATE zclassic23-package-verify program and persisted
 * in the store's attestations/ dir. This command only READS them and
 * evaluates the quorum against the operator's LOCAL approved-verifier
 * allowlist (<datadir>/zcode/approved_verifiers — one 66-hex compressed
 * secp256k1 pubkey per line, '#' comments; anonymous peers are not a
 * quorum). Verified = 2+ approved independent (non-publisher) keys
 * signing matching attestations (same package root, recipe root, release
 * id, result class). */

ZCL_COMMAND_READY_READ(
    "zcode.package.verify", "zcode.package", "",
    "External-verifier attestation quorum for one package root",
    "Evaluates every attestation in the local store's attestations/ dir "
    "against the approved-verifier allowlist for one 64-hex package "
    "`root`: verified=true exactly when 2+ distinct approved verifier keys "
    "(never the release's own publisher key — self-verification and "
    "duplicate signers are named rejections) signed MATCHING attestations "
    "(same package root + recipe root + release id + result class). The "
    "report carries quorum_reached/quorum_class/quorum_signers plus a "
    "bounded per-attestation rows[] naming each rule (counted, "
    "attestation-invalid, package-root-mismatch, recipe-root-mismatch, "
    "signer-not-approved, self-verification, duplicate-signer). "
    "NO_APPROVED_VERIFIERS names a missing/invalid allowlist file "
    "(<datadir>/zcode/approved_verifiers); UNKNOWN_PACKAGE names a root "
    "no persisted release claims.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,verify,attestation,quorum,verifier,approved",
    "zcl.zcode_package_verify.input.v1", "zcl.zcode_package_verify.v1",
    "root,datadir", "root",
    "zclassic23 zcode package verify --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_verify)

/* ── slice 4: contributor identity + ZNAM pointers ─────────────────────
 * The secp256k1 publisher key is the only authoritative identity; ZNAM
 * records are mutable pointers resolved through the canonical ZNAM model
 * and bound only when the name owner equals the publisher key's P2PKH. */

ZCL_COMMAND_BRANCH("zcode.contributor", "zcode",
                   "Contributors: secp256k1 publisher-key identities",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.contributor.show", "zcode.contributor", "",
    "Contributor profile for one publisher pubkey",
    "The profile for one 66-hex publisher key, projected at call time: the "
    "authoritative release facts (count, latest release, reward address — "
    "from the signed envelopes via the rebuilt package index), the slice-8 "
    "reward ledger facts (rewards: earned_score / queued / settled from the "
    "durable reward-history ledger — earned_score and "
    "token_rewards_received are separate SIMULATED facts, never balances), "
    "the slice-9 current-period leaderboard positions (rankings: overall "
    "rank per period from the same projection as the zcode leaderboard "
    "leaves; `day` selects today, host clock when omitted), "
    "a bounded package_roots page (16, package_roots_truncated flags the "
    "rest), and the ZNAM publisher-profile pointer when one claims this "
    "key, with its binding proof (bound only when the name owner equals "
    "the key's P2PKH). has_published=false means the key has no release in "
    "the local store; the ZNAM section is always labelled a pointer, never "
    "identity.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,contributor,show,profile,publisher,identity,znam",
    "zcl.zcode_contributor_show.input.v1",
    "zcl.zcode_contributor_show.v1", "pubkey,day,datadir", "pubkey",
    "zclassic23 zcode contributor show --input='{\"pubkey\":\"<66hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_zcode_contributor_show)

ZCL_COMMAND_READY_READ(
    "zcode.contributor.packages", "zcode.contributor", "",
    "Published releases of one contributor key",
    "One row per release signed by the given 66-hex publisher key, from "
    "the rebuilt package index at call time: name, semver, license, "
    "sequence, release id, package root, bytes. Bounded at 16 rows with "
    "total_matches and items_truncated; an empty list means the key has "
    "not published here, not that the check was skipped.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,contributor,packages,releases,publisher,list",
    "zcl.zcode_contributor_packages.input.v1",
    "zcl.zcode_contributor_packages.v1", "pubkey,datadir", "pubkey",
    "zclassic23 zcode contributor packages --input='{\"pubkey\":\"<66hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE,
    zcl_native_handle_zcode_contributor_packages)

ZCL_COMMAND_READY_READ(
    "zcode.package.resolve", "zcode.package", "",
    "Resolve a ZNAM package name to its release",
    "Resolves a ZNAM name carrying a package pointer (zcode:kind=package) "
    "to the signed release it names, at call time. The output keeps the "
    "two kinds of fact apart: `pointer` (the mutable ZNAM record claims, "
    "with the binding proof) and `identity` (the authoritative signed-"
    "release facts, with matches_pointer_root/publisher cross-checks). "
    "Rejections name the rule: UNKNOWN_NAME, NOT_A_ZCODE_POINTER, "
    "WRONG_POINTER_KIND, POINTER_NOT_BOUND (owner is not the claimed "
    "key), BAD_POINTER_ROOT, RELEASE_NOT_HOSTED.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,package,resolve,znam,pointer,name,identity",
    "zcl.zcode_package_resolve.input.v1",
    "zcl.zcode_package_resolve.v1", "name,datadir", "name",
    "zclassic23 zcode package resolve --input='{\"name\":\"ringbuffer\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_package_resolve)

/* ── slice 7: contribution scoring + reward eligibility ────────────────
 * Bounded DETERMINISTIC scoring over the persisted CAS bytes only (same
 * bytes, same score — no wall-clock, no randomness): semantic units are
 * logical statements (whitespace/brace style/line splits normalized away)
 * diffed by content against the whole ancestor lineage, so moved,
 * renamed, re-added, or duplicated code scores zero. Eligibility is the
 * frozen eight-gate list; a release earns nothing until every gate
 * passes. Both commands are read-only — queue/plan/commit settlement
 * belongs to slice 8. */

ZCL_COMMAND_BRANCH("zcode.reward", "zcode",
                   "Contribution scoring, eligibility, and SIMULATED "
                   "reward settlement (placeholder token id only)",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.reward.score", "zcode.reward", "",
    "Deterministic contribution score breakdown for one release root",
    "Computes the bounded deterministic ZCODE Score for the release "
    "naming one 64-hex package `root`, purely from the persisted manifest "
    "and CAS chunk bytes: the auto-derived category (new-package 500 / "
    "package-update / test-contribution / none), per-line tallies "
    "(semantic, blank, comment-only, brace-only), per-file rows with the "
    "named exclusion reason (not-c-source, vendored-path, generated-path, "
    "generated-marker, file-oversize), the lineage unit diff "
    "(duplicate_within_release, already_rewarded, new_source/new_test — "
    "tests earn 2 points per unit, source 1), the 500 line-point cap and "
    "the 5000 per-release total cap with applied flags, the full "
    "owner-directive scoring_table (manual categories marked "
    "automatic:false), and the period-cap constants. Anti-gaming is by "
    "construction: units are logical statements normalized of whitespace, "
    "brace style, and line splits, content-compared against every "
    "ancestor release, so whitespace-only edits, line splitting, "
    "delete-and-re-add, renames, and copy-paste all score zero. "
    "UNKNOWN_PACKAGE names a root no persisted release claims.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,reward,score,contribution,semantic,lineage,lines,caps",
    "zcl.zcode_reward_score.input.v1", "zcl.zcode_reward_score.v1",
    "root,datadir", "root",
    "zclassic23 zcode reward score --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_reward_score)

ZCL_COMMAND_READY_READ(
    "zcode.reward.eligible", "zcode.reward", "",
    "Reward eligibility gate list for one release root",
    "Evaluates the frozen eight-gate eligibility list for the release "
    "naming one 64-hex package `root`: package-root-verifies (manifest "
    "root matches the envelope and every committed chunk re-verifies from "
    "the CAS), release-signature-verifies, license-accepted (SPDX "
    "allowlist + LICENSE file), parent-lineage-valid (parent release "
    "hosted, verifies, same publisher key, sequence +1), "
    "gcc-build-passes, clang-build-passes, tests-pass (all three read "
    "from the counted quorum attestations — the node never compiles or "
    "executes downloaded code), and verifier-quorum (2+ approved "
    "independent verifier keys signed matching pass attestations, per the "
    "local <datadir>/zcode/approved_verifiers allowlist). eligible is "
    "true only when EVERY gate passes; gates[] reports all eight with "
    "details and failed_gates[] names each failure. UNKNOWN_PACKAGE names "
    "a root no persisted release claims.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,reward,eligible,eligibility,gates,quorum,license,lineage",
    "zcl.zcode_reward_eligible.input.v1", "zcl.zcode_reward_eligible.v1",
    "root,datadir", "root",
    "zclassic23 zcode reward eligible --input='{\"root\":\"<64hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_reward_eligible)


/* ── slice 8: SIMULATED reward settlement ──────────────────────────────
 * The daily settlement queue and the reward-history ledger (durable wires
 * under <datadir>/zcode/rewards, replayed on every call). SIMULATION
 * ONLY: settlement marks entries settled under the configured PLACEHOLDER
 * token id — the real ZCODE ZSLP token is never created, minted, or sent,
 * and no on-chain payout exists in v1 (the owner-reviewed real transfer
 * is slice 14). N payouts settle in ONE batched (simulated) send per
 * settlement window, never one per reward. Manual-category claims queue
 * with an evidence root but are blocked with owner-review-required. */

ZCL_COMMAND_READY_READ(
    "zcode.reward.queue", "zcode.reward", "",
    "Inspect the daily reward settlement queue",
    "Per-state tallies and a bounded page over the durable queue records "
    "under <datadir>/zcode/rewards, replayed at call time: states "
    "(queued, planned — derived from uncommitted plans, settled, rejected "
    "with its named rule), kind (auto from slice-7 scoring, or claim with "
    "its evidence root), category, points, release root, contributor. "
    "Optional `state` filters one state; limit/offset page (32 cap). "
    "corrupt_wires and store_truncated report replay health exactly.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,reward,queue,settlement,pending,claims,tallies",
    "zcl.zcode_reward_queue.input.v1", "zcl.zcode_reward_queue.v1",
    "state,limit,offset,datadir", "",
    "zclassic23 zcode reward queue --input='{\"state\":\"queued\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_reward_queue)

ZCL_COMMAND_READY_COMMAND(
    "zcode.reward.plan", "zcode.reward", "",
    "Assemble one settlement window batch (SIMULATED)",
    "Assembles the batch for one settlement window — the explicit civil "
    "`day` (required, so the same window re-planned over the same ledger "
    "yields the byte-identical plan id) — from every eligible queued "
    "entry, applying the slice-7 period caps (per contributor per week, "
    "rewarded releases per day) against the durable reward-history ledger "
    "batch-atomically. The output names every exclusion rule "
    "(daily-release-cap, weekly-cap-exhausted, owner-review-required for "
    "claims, duplicate-reward, batch-window-full), the planned batch with "
    "requested/settled points and weekly_cap_clamped flags, recipients and "
    "points_total. The ONLY mutation is the persisted plan id (idempotent: "
    "already_persisted flags a re-plan); nothing settles here.",
    0,
    "zcode,reward,plan,settlement,window,batch,caps",
    "zcl.zcode_reward_plan.input.v1", "zcl.zcode_reward_plan.v1",
    "day,datadir", "day",
    "zclassic23 zcode reward plan --input='{\"day\":20500}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_reward_plan)

