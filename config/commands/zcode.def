/* ── slice 11: the LOCAL P2P ratio + anti-spam policy ──────────────────
 * Per-contributor-key verified-bytes accounting (the local service book
 * under <datadir>/zcode/service, replayed on every call), the LOCAL
 * ratio (verified up / max(verified down, 1) — no global ZCODE mint for
 * bandwidth: earned score is the tier gate, so a Sybil pair uploading to
 * each other earns nothing), tier resolution (new user / earned
 * contributor / verified seeder), and the frozen policy table with the
 * absolute free allowance (a zero-score user can always download public
 * packages; the weekly allowance is a rate limit, never a permanent
 * denial). Every rejection names the exact failed rule. The transport
 * that consumes these decisions is slice 12; the publish-frequency
 * checkpoint is already wired into zcode package publish commit. */

ZCL_COMMAND_BRANCH("zcode.seed", "zcode",
                   "Local seeding facts: verified-bytes ratio, tiers, "
                   "allowances",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_READ(
    "zcode.seed.status", "zcode.seed", "",
    "Local serving facts, tier, and allowances per contributor key",
    "Replays the local service book (durable wires under "
    "<datadir>/zcode/service) and the reward ledger at call time: per "
    "contributor key the verified bytes uploaded/downloaded, the LOCAL "
    "ratio (milli), earned score, the resolved tier (new-user / "
    "earned-contributor / verified-seeder), current usage (publishes and "
    "downloads this ISO week, offence total) against the tier "
    "allowances (publish frequency, weekly download bytes, concurrent "
    "downloads, queue priority, pin allowance, announce rate, request "
    "burst). Optional `pubkey` (66-hex) filters one key and adds the "
    "per-kind offence and no-credit breakdowns; `day` pins the window "
    "(default: host today). Rows are bounded (32, rows_truncated flags "
    "the rest); the reply carries the frozen policy_table, the explicit "
    "never_earns_credit list, and the locality note (no global ZCODE "
    "mint for bandwidth — a Sybil upload loop earns nothing).",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,seed,status,ratio,tier,allowance,policy,service",
    "zcl.zcode_seed_status.input.v1", "zcl.zcode_seed_status.v1",
    "pubkey,day,datadir", "",
    "zclassic23 zcode seed status --input='{\"pubkey\":\"<66hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_NODE, ZCL_COMMAND_AUTH_OPERATOR,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_seed_status)

ZCL_COMMAND_READY_READ(
    "zcode.seed.ratio", "zcode.seed", "",
    "The local verified-bytes ratio and exactly how it is computed",
    "The local serving ratio per contributor key (optional `pubkey` "
    "filter; rows bounded at 32): verified_bytes_uploaded, "
    "verified_bytes_downloaded, ratio_milli = uploaded * 1000 / "
    "max(downloaded, 1), and no_credit_bytes. The reply states the "
    "accounting explicitly: verified_only means the bytes were "
    "requested under a distinct request id, delivered, and passed SHA3 "
    "chunk verification; the frozen never_earns_credit list names what "
    "never counts (announcements, unverified bytes, duplicate request "
    "replays, unrequested bytes, invalid chunks, incomplete staging "
    "data); and the locality note states that the ratio is LOCAL per "
    "key — there is no global ZCODE mint for bandwidth, so two Sybil "
    "nodes uploading to each other earn nothing.",
    ZCL_COMMAND_LIST_BUDGET,
    "zcode,seed,ratio,verified,bytes,credit,local",
    "zcl.zcode_seed_ratio.input.v1", "zcl.zcode_seed_ratio.v1",
    "pubkey,datadir", "",
    "zclassic23 zcode seed ratio --input='{\"pubkey\":\"<66hex>\"}'",
