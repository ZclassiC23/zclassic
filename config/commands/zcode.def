/* ── Sovereign Registry v1: zid release records ──────────────────────
 * Sign/verify release records that bind a package release (name, version,
 * manifest root) to an identity's master ed25519 key (lib/zid). File-based
 * only: no DB, no swarm distribution. Domain batching: anchor folds every
 * doc under <datadir>/zcode/releases into the zid anchor-domain tree
 * (record digest = SHA3-256 of the canonical doc wire bytes; digests
 * sorted by bytes so the same dir always folds to the same root) and
 * commits the domain root on-chain; prove emits the zid_proof wire hex
 * for one release; verify --proof/--root checks batch inclusion
 * separately from signature validity.
 * See docs/spec/sovereign-identity-layer.md. */
ZCL_COMMAND_BRANCH("zcode.release", "zcode",
                   "Release records: sign/verify against a master key",
                   ZCL_COMMAND_LAYER_APP)

ZCL_COMMAND_READY_COMMAND(
    "zcode.release.sign", "zcode.release", "",
    "Sign a release record with a master seed",
    "Reads the 32-byte master seed from seed_file (exactly 64 hex chars; "
    "file perms must be 0600/0400 or it is refused with the chmod hint; "
    "the seed is cleansed after use and never logged), builds the "
    "canonical ZIDR release record (name, version, 64-hex manifest root "
    "from `zcode package publish plan`), signs it as a zid doc (seq "
    "monotonic per identity, default 1; expiry unix seconds, default "
    "now+365d), and returns doc_hex + master_pubkey plus a saved copy at "
    "<datadir>/zcode/releases/<name>-<version>.zid. Anyone can check the "
    "doc with `zcode release verify --doc=<hex>` — no chain write, no "
    "fee.", 0,
    "zcode,release,sign,zid,registry,seed,identity",
    "zcl.zcode_release_sign.input.v1", "zcl.zcode_release_sign.v1",
    "name,version,root,seed_file,seq,expiry,datadir", "",
    "zclassic23 zcode release sign --input='{\"name\":\"demo\",\"version\":\"0.1\",\"root\":\"<64hex>\",\"seed_file\":\"/path/seed.hex\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_APP_WRITE, ZCL_COMMAND_SCOPE_LOCAL,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_release_sign)

ZCL_COMMAND_READY_READ(
    "zcode.release.verify", "zcode.release", "",
    "Verify a signed release record (optionally its batch inclusion)",
    "Decodes a zid release doc from --doc=<hex> or --file=<path to a saved "
    ".zid> and verifies it against the current time: prints name, version, "
    "manifest_root, master_pubkey, seq, expiry, and valid. A failing "
    "verification is a hard error naming the reason — DOC_EXPIRED (ask the "
    "publisher for a re-signed doc with a higher seq), BAD_SIGNATURE "
    "(tampered or corrupted), NOT_A_RELEASE_BODY (signed for something "
    "else), DOC_DECODE_FAILED (malformed/truncated hex). With --proof=<hex> "
    "(from `zcode release prove`) and --root=<hex> (the anchored domain "
    "root) given together, additionally checks the doc's record digest is "
    "in the batch that produced root: batch_included is reported "
    "separately from signature validity, and a mismatch is a hard "
    "NOT_IN_BATCH (stale root, wrong batch, or a doc that was never "
    "anchored). With --anchored (plus --datadir), additionally resolves "
    "the doc's master_pubkey against this node's on-chain identity "
    "projection and reports anchored, anchor_height, anchor_txid, "
    "anchor_name, anchor_status and anchor_source — so key trust comes "
    "from the chain instead of a key pinned in a README. That is a "
    "SEPARATE fact from signature validity: a valid signature by an "
    "unanchored key is a hard KEY_NOT_ANCHORED, a valid signature by a "
    "revoked key a hard KEY_REVOKED, and a rotated key still verifies "
    "while reporting its successor.", 0,
    "zcode,release,verify,zid,registry,signature,expiry,proof,batch,"
    "anchored,identity",
    "zcl.zcode_release_verify.input.v1", "zcl.zcode_release_verify.v1",
    "doc,file,proof,root,anchored,datadir", "",
    "zclassic23 zcode release verify --input='{\"doc\":\"<hex>\"}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_SCOPE_LOCAL, ZCL_COMMAND_AUTH_PUBLIC,
    ZCL_COMMAND_LATENCY_FAST, ZCL_COMMAND_COST_LOW,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    ZCL_COMMAND_TRANSPORT_NATIVE, zcl_native_handle_zcode_release_verify)

ZCL_COMMAND_READY_COMMAND(
    "zcode.release.anchor", "zcode.release", "",
    "Anchor the release batch's domain root on-chain",
    "Folds every release doc under <datadir>/zcode/releases into the zid "
    "anchor-domain tree — each record digest is SHA3-256 of the doc's "
    "canonical wire bytes, digests are sorted by bytes before appending "
    "(the determinism contract: the same dir contents ALWAYS fold to the "
    "same domain root) — and anchors the bagged domain root in a ZANC "
    "OP_RETURN (hash_type sha3, label \"zcode@<tip>\": explicit `tip` "
    "wins, else the live node's height, else 0). With a live node the "
    "compose+broadcast rides the anchor_publish RPC (via:\"node_rpc "
    "anchor_publish\"); offline the reply carries op_return_hex to "
    "include manually as vout[0] of any transaction. Anchoring spends a "
    "fee, so it is operator-triggered only. The sorted leaf set and its "
    "root are STORED in zid_domains/zid_domain_leaves (--domain, default "
    "\"zcode\") BEFORE the chain write, so a later `zcode release prove` "
    "proves against what was actually anchored rather than re-scanning a "
    "directory that may have changed; a store failure refuses the anchor "
    "with DOMAIN_STORE. Re-folding to a different root visibly clears the "
    "domain's anchor. Reports releases, domain, domain_root, "
    "domain_stored, and anchor_recorded. NO_RELEASES names an empty "
    "releases dir (sign first with `zcode release sign`); a *.zid file "
    "that does not decode as a release doc fails BATCH_LOAD naming the "
    "file.", 0,
    "zcode,release,anchor,zid,registry,domain,batch,root,zanc",
    "zcl.zcode_release_anchor.input.v1", "zcl.zcode_release_anchor.v1",
    "tip,domain,datadir", "",
    "zclassic23 zcode release anchor --input='{}'",
    ZCL_COMMAND_LAYER_APP, ZCL_COMMAND_EFFECT_MUTATE,
    ZCL_COMMAND_RISK_WALLET, ZCL_COMMAND_SCOPE_NODE,
    ZCL_COMMAND_AUTH_OPERATOR, ZCL_COMMAND_MODE_SYNC,
    ZCL_COMMAND_LATENCY_FOREGROUND, ZCL_COMMAND_COST_MODERATE,
    ZCL_COMMAND_CONFIRM_NONE,
    ZCL_COMMAND_LANE_LOCAL | ZCL_COMMAND_LANE_ALL_NODE,
    ZCL_COMMAND_CAP_NONE, ZCL_COMMAND_TRAIT_IDEMPOTENT,
    zcl_native_handle_zcode_release_anchor)

ZCL_COMMAND_READY_READ(
    "zcode.release.prove", "zcode.release", "",
    "Emit the domain-batch inclusion proof for one release",
    "Emits the zid_proof wire hex for the release named by name+version: "
