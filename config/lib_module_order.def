/* Copyright 2026 Rhett Creighton - Apache License 2.0
 *
 * lib_module_order — the ONE declaration of which lib/ modules exist and in
 * what LINK ORDER. Rank is position: the first line is rank 1, and a module
 * may reference only STRICTLY LOWER ranks. There are no numbers in this file
 * to keep in sync; the order IS the rank.
 *
 * This file declares both the SET and the RANK, and it is the only place
 * either is written down. Everything else derives from it:
 *
 *   Makefile                              LIB_MODULES := $(shell sed ... )
 *                                         — every lib/ source glob and -I flag
 *   tools/lint/repo_shape.sh              ZCL_LIB_MODULES[], for the gates
 *   lib/codeindex/src/codeindex_group.c   k_lib_modules[], an X-macro paste
 *
 * It used to be a third copy of a set the Makefile and the scanner each kept
 * by hand, checked against each other. Deleting those copies removes the
 * cross-check they provided, so the check moved to the one witness that is
 * still independent of this file: the lib/ tree itself. A lib/<mod>/ directory
 * exists whether or not anyone declared it, and both
 * tools/scripts/check_lib_module_order.sh and test_codeindex.c case 6 compare
 * this file's set against it. Rank has no such witness — no build step needs
 * it, so no build step can police it — which is why the gate also enforces the
 * rank rule against the MEASURED link graph (tools/dev/module-linkgraph.sh).
 *
 * A module missing from this file is not a lint warning, it is a module
 * missing from the build.
 *
 * How the order was derived — re-measured 2026-07-26 on today's tree, and
 * re-derivable at any time with two commands:
 *   make build-only -j"$(nproc)"          # the ONLY tree the gate measures
 *   tools/dev/module-linkgraph.sh --fas --obj-root build/obj
 * The graph is 195 lib->lib edges over the 37 lib modules that have any edge
 * at all (lib/znam has none), with 30 strongly-connected components of which
 * two are non-trivial: {metrics sync validation net rpc storage script} and
 * {util health}. The sequence below leaves 5 back edges, and that is OPTIMAL,
 * not merely good: --fas solves each component exactly (minimum feedback arc
 * set decomposes over components) and reports the floor as 4 + 1 = 5, so no
 * reordering of this file can do better. Deleting those 5 and running `tsort`
 * over the remaining 190 confirms the residue is acyclic and covers all 37
 * modules. The 5 are grandfathered in
 * tools/scripts/lib_module_order_baseline.txt and the gate ratchets: the
 * baseline may only shrink, and shrinking it now requires BREAKING A CYCLE,
 * not reordering.
 *
 * Every number in this comment is output of the two commands above, not
 * inherited from an earlier measurement. Re-run them before editing the order,
 * and replace the numbers with what you actually see.
 *
 * Adding a module: put it at the LOWEST rank that keeps the gate green
 * (i.e. below everything it references). Never reorder to make a violation
 * disappear without re-running the tool — the baseline is the record of what
 * we owe, and moving a module to hide an edge just relabels the debt.
 *
 * Not listed here: lib/test (the test runner is not part of the production
 * link order; the Makefile builds it from its own variable).
 */

/* Leaf utilities and low-level building blocks. lib/base is the sink — the
 * logging / allocation / result vocabulary every other module speaks. */
LIB_MODULE("base")
/* Scalar FIPS-202 primitives depend only on base.  Crypto owns optional
 * batched acceleration and reaches down through sha3/sha3.h. */
LIB_MODULE("sha3")
/* Bounded wire cursors depend only on base fixed-width byte helpers. */
LIB_MODULE("codec")
LIB_MODULE("primitives")
LIB_MODULE("support")
LIB_MODULE("json")
LIB_MODULE("encoding")
/* Bounded native bitmap windows. The public API is platform-neutral; the
 * vendored RGFW implementation is private to lib/presentation. */
LIB_MODULE("presentation")
LIB_MODULE("overlay")
LIB_MODULE("platform")
LIB_MODULE("core")
LIB_MODULE("crypto")
LIB_MODULE("zid")
LIB_MODULE("noise")
LIB_MODULE("bloom")

/* The foundation hub. Almost everything above it depends on util; util's one
 * remaining upward reach is util -> health (4 symbols), one of the 5
 * grandfathered back edges. */
LIB_MODULE("util")
LIB_MODULE("sapling")
LIB_MODULE("crypto_registry")
LIB_MODULE("event")
LIB_MODULE("keys")

/* Consensus state, the chain index, transport and observability. These seven
 * — metrics sync validation net rpc storage script — are one strongly
 * connected component, so 4 of the 5 back edges necessarily live in here. */
LIB_MODULE("coins")
LIB_MODULE("chain")
LIB_MODULE("sync")
LIB_MODULE("metrics")
LIB_MODULE("script")
LIB_MODULE("storage")
LIB_MODULE("validation")
LIB_MODULE("net")
LIB_MODULE("rpc")
LIB_MODULE("health")

/* Application-facing subsystems. */
LIB_MODULE("wallet")
LIB_MODULE("framework")

/* On-chain overlays and the top of the stack. */
LIB_MODULE("zslp")
LIB_MODULE("zswap")
LIB_MODULE("znam")
LIB_MODULE("zanc")
LIB_MODULE("zdir")
LIB_MODULE("vcs")
LIB_MODULE("metaverse")
/* lib/session is the CONFINED-AGENT boundary (the broker, its wire protocol,
 * its grant translation and its audit chain), which is why it ranks here,
 * above lib/metaverse: the broker translates a wire frame into a canonical
 * metaverse action and asks metaverse_grant_check() to rule on it, rather
 * than keeping a second opinion about what an action means.
 *
 * It used to sit at rank 11, below everything, because it also held the Noise
 * handshake and the session record layer — which lib/net calls, and lib/net
 * ranks 25. One module doing both jobs could not be ranked correctly for
 * either: below net for the transport, above metaverse for the broker. The
 * Noise half moved to lib/noise (rank 11, where this line used to be) and
 * lib/net now depends on that, so both halves rank where they belong and no
 * back edge was created in either direction. */
LIB_MODULE("session")
LIB_MODULE("sim")
LIB_MODULE("policy")
LIB_MODULE("mining")
LIB_MODULE("kernel")
LIB_MODULE("hotswap")
LIB_MODULE("codeindex")
