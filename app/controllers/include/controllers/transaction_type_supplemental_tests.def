/* Additional exact proof groups for transaction types whose strongest claim
 * is the intersection of independent tests. The primary group remains in
 * transaction_types.def; this file prevents a mined-chain proof from hiding
 * the public workflow or direct-interpreter proof it complements. Keep one
 * row per type; the second field accepts comma-separated test groups. */
TX_TYPE_SUPPLEMENTAL("htlc_initiate", "test_simnet_contract")
TX_TYPE_SUPPLEMENTAL("htlc_participate", "test_simnet_contract")
TX_TYPE_SUPPLEMENTAL("htlc_redeem", "test_simnet_contract")
TX_TYPE_SUPPLEMENTAL("htlc_refund", "test_simnet_contract")
TX_TYPE_SUPPLEMENTAL("blog_anchor", "test_native_api_contract,test_simnet,test_transaction_intent")
