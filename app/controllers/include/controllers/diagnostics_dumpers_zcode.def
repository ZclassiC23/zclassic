/* Per-domain dumpstate subsystem descriptors: ZCODE package store and related VCS-hosting state
 *
 * Split from diagnostics_dumpers.def (see that file's aggregator
 * comment for the shared #include contract). Data-only: no macro
 * definitions or include guards belong in this file. */

    DIAG_ENTRY("zcode_store", vcs_package_store_dump_state_json,
               "ZCODE package store (local, -packagehost): quota pool "
               "budgets/usage for pins/hot/rare/staging, tracked packages, "
               "CAS chunk count, evictions_total, gc_orphans_total, "
               "quota_rejects_total, releases_total (persisted release "
               "envelopes on disk), last_release_accept/last_release_id "
               "(slice 3 publication outcome, in-memory); enabled=false "
               "when hosting is off",
               "runtime", "runtime", "lib/vcs/src/package_store.c",
               "in_process_snapshot", "cheap",
               "64-hex package root, or empty for store-wide totals",
               "9f91360a486a1291533cad369861c371d4b5bc0682748ee768755c730f574eba",
               NULL,
               "lib/test/src/test_zcode_store.c", false),
