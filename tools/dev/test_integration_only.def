ZCL_TEST_INTEGRATION_ONLY("test_make_lint_gates_shard_06")
ZCL_TEST_INTEGRATION_ONLY("test_make_lint_gates_shard_07")
ZCL_TEST_INTEGRATION_ONLY("test_make_lint_gates_shard_08")
